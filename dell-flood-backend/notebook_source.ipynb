import torch
import torch.nn as nn
import torch.nn.functional as F


class FPNDecoder(nn.Module):

    def __init__(self):

        super().__init__()

        # -----------------------
        # Lateral Convolutions
        # -----------------------

        self.lat1 = nn.Conv2d(64, 256, kernel_size=1)

        self.lat2 = nn.Conv2d(128, 256, kernel_size=1)

        self.lat3 = nn.Conv2d(320, 256, kernel_size=1)

        self.lat4 = nn.Conv2d(512, 256, kernel_size=1)

        # -----------------------
        # Smooth Block
        # -----------------------

        def smooth():

            return nn.Sequential(

                nn.Conv2d(
                    256,
                    256,
                    kernel_size=3,
                    padding=1,
                    bias=False
                ),

                nn.BatchNorm2d(256),

                nn.GELU()

            )

        self.s1 = smooth()
        self.s2 = smooth()
        self.s3 = smooth()
        self.s4 = smooth()

        # -----------------------
        # Final Merge
        # -----------------------

        self.merge = nn.Sequential(

            nn.Conv2d(
                1024,
                256,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            nn.BatchNorm2d(256),

            nn.GELU()

        )

    def forward(self, feats):

        f1, f2, f3, f4 = feats

        # -----------------------
        # Top Down Path
        # -----------------------

        p4 = self.lat4(f4)

        p3 = self.lat3(f3) + F.interpolate(
            p4,
            size=f3.shape[-2:],
            mode="bilinear",
            align_corners=False
        )

        p2 = self.lat2(f2) + F.interpolate(
            p3,
            size=f2.shape[-2:],
            mode="bilinear",
            align_corners=False
        )

        p1 = self.lat1(f1) + F.interpolate(
            p2,
            size=f1.shape[-2:],
            mode="bilinear",
            align_corners=False
        )

        # -----------------------
        # Smooth
        # -----------------------

        p1 = self.s1(p1)
        p2 = self.s2(p2)
        p3 = self.s3(p3)
        p4 = self.s4(p4)

        # -----------------------
        # Upsample
        # -----------------------

        target_size = p1.shape[-2:]

        p2 = F.interpolate(
            p2,
            size=target_size,
            mode="bilinear",
            align_corners=False
        )

        p3 = F.interpolate(
            p3,
            size=target_size,
            mode="bilinear",
            align_corners=False
        )

        p4 = F.interpolate(
            p4,
            size=target_size,
            mode="bilinear",
            align_corners=False
        )

        fused = torch.cat(
            [p1, p2, p3, p4],
            dim=1
        )

        fused = self.merge(fused)

        return fused


decoder = FPNDecoder().cuda()

with torch.no_grad():

    x = decoder(
        [f1, f2, f3, f4]
    )

print(x.shape)

print(torch.isnan(x).any())

