class Sen1FloodDataset(Dataset):

    def __init__(self, dataframe, transform=None):
        self.df = dataframe.reset_index(drop=True)
        self.transform = transform

    def __len__(self):

        return len(self.df)

    def read_s1(self, path):

        with rasterio.open(path) as src:
            img = src.read().astype(np.float32)
    
        # Replace NaN and Inf
        img = np.nan_to_num(
            img,
            nan=0.0,
            posinf=0.0,
            neginf=0.0
        )
    
        return img
        
    def read_s2(self, path):

        with rasterio.open(path) as src:
            img = src.read().astype(np.float32)
    
        img = np.nan_to_num(
            img,
            nan=0.0,
            posinf=0.0,
            neginf=0.0
        )
    
        return img

    def read_mask(self, path):

        with rasterio.open(path) as src:
            mask = src.read(1).astype(np.float32)
    
        mask = np.nan_to_num(mask)
    
        return mask

    def __getitem__(self, idx):

        row = self.df.iloc[idx]

        s1_name = row["s1_file"]
        label_name = row["label_file"]

        s2_name = s1_name.replace(
            "_S1Hand",
            "_S2Hand"
        )

        sar_path = os.path.join(
            S1_DIR,
            s1_name
        )

        optical_path = os.path.join(
            S2_DIR,
            s2_name
        )

        mask_path = os.path.join(
            LABEL_DIR,
            label_name
        )

        # -----------------------
        # SAR
        # -----------------------

        sar = self.read_s1(sar_path)

        # -----------------------
        # Optical
        # -----------------------

        optical = self.read_s2(optical_path)

        # RGB + NIR
        optical = optical[[3, 2, 1, 7]]

        # Normalize
        optical = optical / 10000.0

        optical = np.clip(
            optical,
            0.0,
            1.0
        )

        # -----------------------
        # Mask
        # -----------------------

        mask = self.read_mask(mask_path)

        mask[mask == -1] = 0

        mask = (mask > 0).astype(np.float32)

        mask = np.expand_dims(
            mask,
            axis=0
        )

        if self.transform is not None:
        
            merged = np.concatenate(
                [sar, optical, mask],
                axis=0
            )
        
            merged = np.transpose(merged, (1, 2, 0))
        
            augmented = self.transform(image=merged)["image"]
        
            augmented = np.transpose(augmented, (2, 0, 1))
        
            sar = augmented[:2]
        
            optical = augmented[2:6]
        
            mask = augmented[6:]

        if np.isnan(sar).any():
            print("NaN SAR:", s1_name)
        
        if np.isnan(optical).any():
            print("NaN OPT:", s2_name)
        
        if np.isnan(mask).any():
            print("NaN MASK:", label_name)

        return (
            torch.from_numpy(sar).float(),
            torch.from_numpy(optical).float(),
            torch.from_numpy(mask).float()
        )


