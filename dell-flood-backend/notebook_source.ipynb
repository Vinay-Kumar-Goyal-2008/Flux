import torch

def train_one_epoch(
    model,
    loader,
    optimizer,
    criterion,
    device
):

    model.train()

    running_loss = 0

    pbar = tqdm(loader)

    for batch_idx, (sar, optical, mask) in enumerate(pbar):

        sar = sar.to(device)
        optical = optical.to(device)
        mask = mask.to(device)

        optimizer.zero_grad(set_to_none=True)

        pred = model(sar, optical)

        loss = criterion(pred, mask)

        loss.backward()

        torch.nn.utils.clip_grad_norm_(
            model.parameters(),
            1.0
        )

        optimizer.step()

        running_loss += loss.item()

        pbar.set_postfix(
            loss=loss.item()
        )

        if batch_idx == 0:

            print()

            print("Prediction Min :", pred.min().item())
            print("Prediction Max :", pred.max().item())

            print("Loss :", loss.item())

    return running_loss / len(loader)


from tqdm.auto import tqdm
import torch

def train_one_epoch(
    model,
    loader,
    optimizer,
    criterion,
    device
):

    model.train()

    running_loss = 0

    pbar = tqdm(loader)

    for batch_idx, (sar, optical, mask) in enumerate(pbar):

        sar = sar.to(device)
        optical = optical.to(device)
        mask = mask.to(device)

        
        optimizer.zero_grad(set_to_none=True)

        pred = model(sar, optical)

        if torch.isnan(pred).any():
            raise RuntimeError("Prediction became NaN")
        loss = criterion(pred, mask)
        
        if torch.isnan(loss):
            raise RuntimeError("Loss became NaN")

        loss.backward()

        torch.nn.utils.clip_grad_norm_(
            model.parameters(),
            1.0
        )

        optimizer.step()

        running_loss += loss.item()

        pbar.set_postfix(
            loss=loss.item()
        )

        if batch_idx == 0:

            print()

            print("Prediction Min :", pred.min().item())
            print("Prediction Max :", pred.max().item())

            print("Loss :", loss.item())

    return running_loss / len(loader)


