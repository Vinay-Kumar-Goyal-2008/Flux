import torch
import torch.nn as nn
import torch.nn.functional as F


class DualFloodSegFormer(nn.Module):

    def __init__(self):

        super().__init__()

        # -------------------------
        # Dual Encoder
        # -------------------------
        self.encoder = DualMiTB2()

        # -------------------------
        # Fusion
        # -------------------------
        self.fuse64 = GatedFusion(64)
        self.fuse128 = GatedFusion(128)

        self.fuse320 = CrossAttentionFusion(320)
        self.fuse512 = CrossAttentionFusion(512)

        # -------------------------
        # Decoder
        # -------------------------
        self.decoder = FPNDecoder()

        # -------------------------
        # Boundary Refinement
        # -------------------------
        self.boundary = BoundaryRefinement(256)

        # -------------------------
        # Segmentation Head
        # -------------------------
        self.head = nn.Sequential(

            nn.Conv2d(
                256,
                128,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            nn.BatchNorm2d(128),

            nn.GELU(),

            nn.Conv2d(
                128,
                1,
                kernel_size=1
            )
        )

    def forward(self, sar, optical):

        # -------------------------
        # Encoder
        # -------------------------
        sar_feats, opt_feats = self.encoder(
            sar,
            optical
        )

        # -------------------------
        # Fusion
        # -------------------------
        f1 = self.fuse64(
            sar_feats[0],
            opt_feats[0]
        )

        f2 = self.fuse128(
            sar_feats[1],
            opt_feats[1]
        )

        f3 = self.fuse320(
            sar_feats[2],
            opt_feats[2]
        )

        f4 = self.fuse512(
            sar_feats[3],
            opt_feats[3]
        )

        # -------------------------
        # Decoder
        # -------------------------
        x = self.decoder(
            [f1, f2, f3, f4]
        )

        # -------------------------
        # Boundary Refinement
        # -------------------------
        x = self.boundary(x)

        # -------------------------
        # Segmentation Head
        # -------------------------
        logits = self.head(x)

        logits = F.interpolate(
            logits,
            size=(512,512),
            mode="bilinear",
            align_corners=False
        )

        return logits


