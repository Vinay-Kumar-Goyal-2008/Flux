import torch
import torch.nn as nn

class GatedFusion(nn.Module):

    def __init__(self, channels):
        super().__init__()

        self.gate = nn.Sequential(
            nn.Conv2d(channels * 2, channels, kernel_size=1, bias=False),
            nn.BatchNorm2d(channels),
            nn.Sigmoid()
        )

        self.refine = nn.Sequential(
            nn.Conv2d(channels, channels, kernel_size=3, padding=1, bias=False),
            nn.BatchNorm2d(channels),
            nn.GELU()
        )

    def forward(self, sar, optical):

        gate = self.gate(
            torch.cat([sar, optical], dim=1)
        )

        fused = gate * sar + (1.0 - gate) * optical

        fused = self.refine(fused)

        return fused


import torch
import torch.nn as nn

class CrossAttentionFusion(nn.Module):

    def __init__(self, channels, heads=8):

        super().__init__()

        self.norm_sar = nn.LayerNorm(channels)
        self.norm_opt = nn.LayerNorm(channels)

        self.attn_sar = nn.MultiheadAttention(
            embed_dim=channels,
            num_heads=heads,
            batch_first=True
        )

        self.attn_opt = nn.MultiheadAttention(
            embed_dim=channels,
            num_heads=heads,
            batch_first=True
        )

        self.gamma = nn.Parameter(torch.zeros(1))

        self.refine = nn.Sequential(
            nn.Conv2d(channels, channels, kernel_size=3, padding=1, bias=False),
            nn.BatchNorm2d(channels),
            nn.GELU()
        )

    def forward(self, sar, optical):

        B, C, H, W = sar.shape

        sar_tokens = sar.flatten(2).transpose(1, 2)
        opt_tokens = optical.flatten(2).transpose(1, 2)

        sar_tokens = self.norm_sar(sar_tokens)
        opt_tokens = self.norm_opt(opt_tokens)

        sar_attn, _ = self.attn_sar(
            query=sar_tokens,
            key=opt_tokens,
            value=opt_tokens
        )

        opt_attn, _ = self.attn_opt(
            query=opt_tokens,
            key=sar_tokens,
            value=sar_tokens
        )

        fused = (
            sar_tokens
            + opt_tokens
            + self.gamma * (sar_attn + opt_attn)
        )

        fused = fused.transpose(1, 2).reshape(B, C, H, W)

        fused = self.refine(fused)

        return fused


device = torch.device("cuda")

g64 = GatedFusion(64).to(device)
g128 = GatedFusion(128).to(device)

ca320 = CrossAttentionFusion(320).to(device)
ca512 = CrossAttentionFusion(512).to(device)

