import torch
import torch.nn as nn
from transformers import SegformerModel

def create_encoder(in_channels):

    encoder = SegformerModel.from_pretrained(
        "nvidia/mit-b2"
    )

    encoder.config.output_hidden_states = True

    old_proj = encoder.encoder.patch_embeddings[0].proj

    new_proj = nn.Conv2d(
        in_channels=in_channels,
        out_channels=old_proj.out_channels,
        kernel_size=old_proj.kernel_size,
        stride=old_proj.stride,
        padding=old_proj.padding,
        bias=False
    )

    with torch.no_grad():

        if in_channels == 2:

            weight = old_proj.weight.mean(
                dim=1,
                keepdim=True
            )

            weight = weight.repeat(
                1,
                2,
                1,
                1
            )

        elif in_channels == 4:

            rgb = old_proj.weight

            nir = rgb.mean(
                dim=1,
                keepdim=True
            )

            weight = torch.cat(
                [rgb, nir],
                dim=1
            )

        else:

            raise ValueError(
                "Only 2 or 4 input channels are supported."
            )

        new_proj.weight.copy_(weight)

    encoder.encoder.patch_embeddings[0].proj = new_proj

    return encoder


class DualMiTB2(nn.Module):

    def __init__(self):

        super().__init__()

        self.sar_encoder = create_encoder(2)

        self.optical_encoder = create_encoder(4)

    def forward(self, sar, optical):

        sar_feats = self.sar_encoder(
            pixel_values=sar,
            output_hidden_states=True
        ).hidden_states

        optical_feats = self.optical_encoder(
            pixel_values=optical,
            output_hidden_states=True
        ).hidden_states

        return sar_feats, optical_feats


device = torch.device("cuda")

