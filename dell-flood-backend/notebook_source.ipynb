import torch
import torch.nn as nn

class BoundaryRefinement(nn.Module):

    def __init__(self, channels=256):

        super().__init__()

        self.refine = nn.Sequential(

            nn.Conv2d(
                channels,
                channels,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            nn.BatchNorm2d(channels),

            nn.GELU(),

            nn.Conv2d(
                channels,
                channels,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            nn.BatchNorm2d(channels),

            nn.GELU()

        )

    def forward(self, x):

        return x + self.refine(x)


boundary = BoundaryRefinement().cuda()

with torch.no_grad():

    y = boundary(x)

