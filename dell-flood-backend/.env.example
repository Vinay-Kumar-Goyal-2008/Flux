# Sentinel Hub API Credentials
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your_openweather_api_key

# Twilio Credentials (Unified for SMS & IVR)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SendGrid Email Credentials
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_verified_from_email

# Optional Exotel Credentials (Fallback IVR)
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token

# RAG & Agent Reasoning API Keys (Configure at least one)
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Mapbox Token (Required for Geocoding & Map renders)
MAPBOX_TOKEN=your_mapbox_public_token

# Central Water Commission River Gauge API Key
CWC_API_KEY=your_cwc_api_key

# Machine Learning Model Configuration
MODEL_WEIGHTS_PATH=app/ml/weights/mit_b2_segformer.onnx
MODEL_CONFIDENCE_THRESHOLD=0.5

# Database Config
DATABASE_URL=sqlite:///./flood_database.db
CHROMA_DB_PATH=./chroma_data
